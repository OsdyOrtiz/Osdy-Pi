{
	"name": "osdy-pi",
	"version": "0.1.9",
	"description": "Osdy Pi package: themes, header, and custom editor for Pi.",
	"license": "MIT",
	"type": "module",
	"keywords": [
		"pi-package",
		"pi",
		"theme",
		"extension"
	],
	"scripts": {
		"typecheck": "tsc --noEmit",
		"lint": "eslint .",
		"pi:dev": "node ./scripts/pi-dev.mjs"
	},
	"files": [
		"README.md",
		"LICENSE",
		"themes",
		"extensions",
		"mapche1.png"
	],
	"pi": {
		"themes": [
			"./themes/osdy-pi-dark.json",
			"./themes/osdy-pi-light.json",
			"./themes/osdy-pi-simple.json"
		],
		"extensions": [
			"./extensions/osdy-pi.ts"
		],
		"image": "https://raw.githubusercontent.com/OsdyOrtiz/Osdy-Pi/main/mapche1.png"
	},
	"peerDependencies": {
		"@earendil-works/pi-coding-agent": "*",
		"@earendil-works/pi-tui": "*"
	},
	"devDependencies": {
		"@earendil-works/pi-coding-agent": "^0.74.1",
		"@earendil-works/pi-tui": "^0.74.1",
		"@eslint/js": "^9.39.1",
		"@types/node": "^25.8.0",
		"eslint": "^9.39.1",
		"typescript": "^5.9.3",
		"typescript-eslint": "^8.46.3"
	}
}
